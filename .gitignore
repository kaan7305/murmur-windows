# Local working notes and editor state. Not part of the published project.
CLAUDE.md
.claude/

# Python
__pycache__/
*.py[cod]
.venv/

# Build output. build.bat regenerates all of it:
#   build\   PyInstaller's work directory      (~33 MB)
#   dist\    the frozen app, installer, GPU pack (~2 GB)
build/
dist/

# Drawn from logo.py by build.bat, step 1 of 4.
murmur.ico

# Scratch captures, kept out of the history because they are regenerated
# whenever a screen changes and none of them is a source file. The leading
# underscore is what marks a capture as scratch; the directory does not matter,
# since this pattern is unanchored and so catches docs\_try.png too. Screenshots
# the README publishes are the ones people see before installing anything, so
# they are worth committing: _cap.ps1 defaults to docs\screenshot.png, a plain
# name this rule leaves alone.
_*.png

# Site is deployed from a private repo (murmur-site) to Vercel.
# It must not appear in this public repository.
site/
